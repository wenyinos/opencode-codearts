# Daily timer for the CodeArts check-in. Install with:
#   cp scripts/opencode-codearts-signin.timer ~/.config/systemd/user/
#   cp scripts/opencode-codearts-signin.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now opencode-codearts-signin.timer
#
# The timer runs at 08:00 local time and catches up after a missed run
# (Persistent=true). Adjust OnCalendar if you prefer another time.

[Unit]
Description=Daily CodeArts check-in

[Timer]
OnCalendar=*-*-* 08:00:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
