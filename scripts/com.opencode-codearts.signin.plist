<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd daily check-in agent for opencode-codearts (macOS).

  Install:
    mkdir -p ~/Library/LaunchAgents
    cp scripts/com.opencode-codearts.signin.plist ~/Library/LaunchAgents/
    # edit the paths marked EDIT below
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.opencode-codearts.signin.plist

  Logs: ~/Library/Logs/opencode-codearts-signin.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.opencode-codearts.signin</string>

  <!-- >>> EDIT THESE to your node binary and install location >>> -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/Users/me/OpenCodePlugins/opencode-codearts/dist/signin-cli.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/me/OpenCodePlugins/opencode-codearts</string>
  <!-- <<< EDIT <<< -->

  <key>EnvironmentVariables</key>
  <dict>
    <key>CODEARTS_WEB_COOKIE_FILE</key>
    <string>/Users/me/.config/opencode/opencode-codearts/web-cookie.txt</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/me/Library/Logs/opencode-codearts-signin.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/me/Library/Logs/opencode-codearts-signin.log.err</string>
</dict>
</plist>
