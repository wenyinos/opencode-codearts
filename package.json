{
  "name": "opencode-codearts",
  "version": "1.1.0",
  "description": "OpenCode provider plugin for Huawei Cloud CodeArts (码道) models, authenticated with CODEARTS_CLI_AK / CODEARTS_CLI_SK environment variables.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "exports": {
    "./server": "./dist/index.js",
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "opencode": ">=1.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/daemon.js",
    "start:proxy": "node dist/proxy-cli.js",
    "login": "node dist/login-cli.js",
    "signin": "node dist/signin-cli.js",
    "signin:import-cookie": "node dist/import-cookie.js",
    "signin:enable": "bash scripts/enable-signin-timer.sh",
    "signin:disable": "bash scripts/disable-signin-timer.sh",
    "print-provider": "node dist/print-provider.js",
    "clean": "node -e \"import('fs').then(f=>f.rmSync('dist',{recursive:true,force:true}))\""
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.17.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "codearts",
    "huaweicloud",
    "pangu",
    "maas",
    "ai-sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wenyinos/opencode-codearts.git"
  },
  "homepage": "https://github.com/wenyinos/opencode-codearts#readme",
  "bugs": {
    "url": "https://github.com/wenyinos/opencode-codearts/issues"
  }
}
